# Model: provider:model. Providers: anthropic, openai, gemini, deepseek, kimi, qwen, openai_compat
FLEET_MODEL=anthropic:claude-opus-5-5
# FLEET_EFFORT=medium            # Anthropic effort: low | medium | high | xhigh | max
# FLEET_TEMPERATURE=0            # OpenAI-compatible providers; "none" to omit
# FLEET_LLM_MODE=live            # live | record | replay
# FLEET_RPM=10                   # client-side rate limit (free-tier keys)
# FLEET_DECISIONS=auto           # gemini-decision-1 guard + faithfulness: auto (on if GEMINI_API_KEY) | on | off

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
